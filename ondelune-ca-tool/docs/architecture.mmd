flowchart TB
    subgraph IN["输入"]
        A1["客户档案<br/>层级 · 偏好 · 购买记录 · 敏感状态"]
        A2["场景 + 本次任务<br/>节日 · 触达理由 · 活动"]
        A3["对话记录"]
        A4["产品信息（SKU）"]
    end

    subgraph CFG["品牌配置（换品牌 = 换配置）"]
        C1["brand.yaml<br/>调性规则 · 词表 · 红线"]
        C2["scenarios.yaml<br/>6 个场景 playbook"]
        C3["products.json<br/>产品库 · 适饮期"]
        C5["exemplars.yaml<br/>人工范例（v2）"]
        C4["models.yaml<br/>DeepSeek / 千问 / Kimi"]
    end

    IN --> P0["① 预检<br/>未成年 · 敏感状态 · 连续未回复<br/>客户拒绝过（v2）· 触达理由 · 层级资格<br/>有风险 → 提示 CA"]
    P0 -- "不应发送" --> STOP["⛔ 返回原因，不生成"]

    P0 --> P1["② 检索（结构化 RAG）<br/>按场景过滤产品 · 偏好打分<br/>按场景取范例（v2）"]
    C3 --> P1
    C5 --> P1
    P1 --> P2["③ 生成<br/>deepseek-flash · 一次 3 条<br/>温度型 / 内容型 / 轻量型"]
    C1 --> P2
    C2 --> P2
    C4 --> P2
    P2 --> P3["④ 第 1 层：硬规则（代码）<br/>长度 · 称呼 · 词表 · 幻觉比对 · 场景规则"]
    P3 --> P4["⑤ 第 2 层：LLM 裁判<br/>deepseek-v4-pro · 5 维 1–5 分"]
    P4 --> G{"分级"}
    G -- "不可接受且重写 < 2 轮" --> RW["⑥ 单条重写<br/>带上违规原因"]
    RW --> P3
    G -- "好 / 可接受" --> SET["⑦ 三条相似度检查"]
    G -- "重写 2 轮仍不可接受" --> SET
    SET --> OUT["输出给 CA：3 条候选 + 等级 + 提示"]
    OUT --> XL["结果边跑边存 · 可续跑（v2）<br/>Excel：用例表 · 评估明细 · 汇总"]
    OUT -. "抽样 30 条" .-> H["第 3 层：人工盲评<br/>发现的缺陷 → 改规则 / 范例 / rubric → 下一版"]
